# ============================================
# OpenClaw Bot Alpha - 環境変数設定
# ============================================
# このファイルを .env にコピーして値を入力してください:
#   cp .env.example .env
#
# ---- AI プロバイダー (いずれか1つ以上) ----
ANTHROPIC_API_KEY=sk-ant-ここにAnthropicのAPIキーをペースト
# OPENAI_API_KEY=sk-ここにOpenAIのAPIキーをペースト
# OPENROUTER_API_KEY=ここにOpenRouterのAPIキーをペースト

# ---- Discord Bot トークン ----
DISCORD_BOT_TOKEN=ここにBot AlphaのDiscordトークンをペースト

# ---- (任意) Gateway内部トークン ----
# OPENCLAW_GATEWAY_TOKEN=任意のランダム文字列
