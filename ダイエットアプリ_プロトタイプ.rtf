            \{ name: "\uc0\u23665 \u26412 ", initial: 70, current: 69.5, color: '#6366f1', status: 'down' \}\
        ];\
        let myChart = null;\
\
        // --- Navigation & View Logic ---\
        function switchView(viewId) \{\
            // Hide all views\
            document.querySelectorAll('[id^="view-"]').forEach(el => \{\
                el.classList.add('hidden');\
                el.classList.remove('fade-in');\
            \});\
            \
            // Show selected view\
            const target = document.getElementById(`view-$\{viewId\}`);\
            target.classList.remove('hidden');\
            // Re-trigger animation\
            void target.offsetWidth; \
            target.classList.add('fade-in');\
\
            // Update Header Title based on View\
            const headerTitle = document.getElementById('headerTitle');\
            const titles = \{\
                'home': '<i class="fas fa-fire-alt text-orange-300"></i> \uc0\u33026 \u32938 \u29123 \u28988 \u38538 ',\
                'analysis': '\uc0\u35443 \u32048 \u20998 \u26512 ',\
                'food': '\uc0\u39135 \u20107 \u35352 \u37682 ',\
                'settings': '\uc0\u35373 \u23450 '\
            \};\
            headerTitle.innerHTML = titles[viewId] || 'Squad Fit';\
\
            // Update Nav State\
            document.querySelectorAll('.nav-btn').forEach(btn => \{\
                btn.classList.remove('nav-active', 'text-teal-500');\
                btn.classList.add('nav-inactive', 'text-gray-400');\
            \});\
            const activeBtn = document.getElementById(`btn-$\{viewId\}`);\
            if(activeBtn) \{\
                activeBtn.classList.remove('nav-inactive', 'text-gray-400');\
                activeBtn.classList.add('nav-active', 'text-teal-500');\
            \}\
\
            // Scroll to top\
            document.getElementById('mainContainer').scrollTop = 0;\
\
            // If analysis view, ensure chart is rendered\
            if (viewId === 'analysis' && !myChart) \{\
                setTimeout(initChart, 100);\
            \} else if (viewId === 'analysis' && myChart) \{\
                myChart.update();\
            \}\
        \}\
\
        function openModal(type) \{\
            document.getElementById('modal-add').classList.remove('hidden');\
        \}\
\
        function closeModal() \{\
            document.getElementById('modal-add').classList.add('hidden');\
        \}\
\
        // --- Business Logic ---\
        function calculateStats(member) \{\
            const loss = member.initial - member.current;\
            const pct = (loss / member.initial) * 100;\
            return \{ ...member, loss: loss.toFixed(1), pct: pct.toFixed(2) \};\
        \}\
\
        function renderRanking() \{\
            const list = document.getElementById('rankingList');\
            list.innerHTML = '';\
            const sortedMembers = members.map(calculateStats).sort((a, b) => b.pct - a.pct);\
\
            sortedMembers.forEach((m, index) => \{\
                const rankClass = index === 0 ? 'rank-1' : (index === 1 ? 'rank-2' : (index === 2 ? 'rank-3' : ''));\
                const rankDisplay = index === 0 \
                    ? `<div class="w-6 flex justify-center"><i class="fas fa-trophy text-yellow-500 text-lg"></i></div>`\
                    : `<div class="font-bold text-gray-400 w-6 text-lg text-center">$\{index + 1\}</div>`;\
                const meBadge = m.isMe ? '<span class="ml-2 text-[10px] bg-teal-100 text-teal-600 px-1.5 py-0.5 rounded font-bold">YOU</span>' : '';\
\
                list.innerHTML += `\
                <div class="flex items-center p-3 border-b border-gray-50 hover:bg-gray-50 transition-colors $\{rankClass\}">\
                    $\{rankDisplay\}\
                    <div class="relative mx-3">\
                        <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-white font-bold shadow-sm text-sm" style="background-color: $\{m.color\}">$\{m.name.charAt(0)\}</div>\
                         $\{index === 0 ? '<div class="absolute -top-1 -right-1 text-xs animate-bounce">\uc0\u55357 \u56613 </div>' : ''\}\
                    </div>\
                    <div class="flex-1 min-w-0">\
                        <div class="flex items-center"><div class="font-bold text-gray-800 text-sm truncate">$\{m.name\}</div>$\{meBadge\}</div>\
                        <div class="text-[10px] text-gray-400 truncate">\uc0\u30446 \u27161 \u12414 \u12391 \u12354 \u12392  $\{(m.current - (m.initial * 0.9)).toFixed(1)\}kg</div>\
                    </div>\
                    <div class="text-right pl-2">\
                        <div class="font-bold text-teal-600 text-lg leading-none">-$\{m.pct\}<span class="text-xs">%</span></div>\
                        <div class="text-[10px] text-gray-400 mt-1">total -$\{m.loss\}kg</div>\
                    </div>\
                </div>`;\
            \});\
        \}\
\
        function handleUpdateWeight() \{\
            const input = document.getElementById('weightInput');\
            const feedbackArea = document.getElementById('feedbackArea');\
            if(input.value && parseFloat(input.value) > 0) \{\
                const me = members.find(m => m.isMe);\
                me.current = parseFloat(input.value);\
                input.value = '';\
                feedbackArea.classList.remove('hidden');\
                renderRanking();\
                if(myChart) updateChartData();\
                setTimeout(() => feedbackArea.classList.add('hidden'), 3000);\
            \}\
        \}\
\
        function like(btn) \{\
            const countSpan = btn.querySelector('span');\
            let count = parseInt(countSpan.innerText);\
            if (!btn.classList.contains('text-pink-500')) \{\
                btn.classList.remove('text-gray-400');\
                btn.classList.add('text-pink-500', 'pop-anim');\
                btn.querySelector('i').classList.replace('far', 'fas');\
                countSpan.innerText = count + 1;\
                setTimeout(() => btn.classList.remove('pop-anim'), 300);\
            \}\
        \}\
\
        // --- Chart ---\
        function initChart() \{\
            const ctx = document.getElementById('teamChart');\
            if(!ctx) return;\
            \
            const labels = ['1\uc0\u36913 \u38291 \u21069 ', '5\u26085 \u21069 ', '3\u26085 \u21069 ', '1\u26085 \u21069 ', '\u20170 \u26085 '];\
            const datasets = members.map(m => \{\
                const range = m.initial - m.current;\
                const data = [m.initial, m.initial-(range*0.2), m.initial-(range*0.5), m.initial-(range*0.8), m.current]\
                    .map(v => v + (Math.random()*0.5 - 0.25));\
                return \{\
                    label: m.name,\
                    data: data,\
                    borderColor: m.color,\
                    backgroundColor: m.color,\
                    tension: 0.4,\
                    pointRadius: 2,\
                    borderWidth: 2\
                \};\
            \});\
\
            myChart = new Chart(ctx.getContext('2d'), \{\
                type: 'line',\
                data: \{ labels, datasets \},\
                options: \{\
                    responsive: true,\
                    maintainAspectRatio: false,\
                    interaction: \{ mode: 'index', intersect: false \},\
                    plugins: \{\
                        legend: \{ position: 'bottom', labels: \{ boxWidth: 8, usePointStyle: true, font: \{ size: 10 \} \} \},\
                        tooltip: \{ backgroundColor: 'rgba(255,255,255,0.9)', titleColor:'#333', bodyColor:'#666', borderColor:'#ddd', borderWidth:1 \}\
                    \},\
                    scales: \{\
                        y: \{ display: true, grid: \{ color: '#f0f0f0' \}, ticks: \{ font:\{size:10\}, color:'#9ca3af' \} \},\
                        x: \{ grid: \{ display: false \}, ticks: \{ font:\{size:10\}, color:'#9ca3af' \} \}\
                    \}\
                \}\
            \});\
        \}\
        \
        function updateChartData() \{\
            if(!myChart) return;\
            const me = members.find(m => m.isMe);\
            const myDataset = myChart.data.datasets.find(d => d.label === me.name);\
            if(myDataset) \{\
                myDataset.data[4] = me.current; // Update 'Today'\
                myChart.update();\
            \}\
        \}\
\
        // Init\
        window.onload = () => \{\
            renderRanking();\
            setTimeout(() => document.getElementById('progressBar').style.width = '62%', 500);\
        \};\
    </script>\
</body>\
</html>}